# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------- credentials
LLM_API_KEY=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# ---------------------------------------------------------------- LLM
LLM_BASE_URL=https://genailab.tcs.in
LLM_MODEL=azure/genailab-maas-gpt-4.1
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------- market data
ALPACA_TRADING_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_NEWS_URL=https://data.alpaca.markets/v1beta1/news
# iex = free tier. sip needs a paid market-data subscription.
ALPACA_FEED=iex

# ---------------------------------------------------------------- guardrails
HITL_QTY_THRESHOLD=5
HITL_TURN_QTY_THRESHOLD=5
HITL_NOTIONAL_THRESHOLD=5000

# ---------------------------------------------------------------- demo
# 1 = deterministic synthetic market, no live feed needed.
SYNTHETIC_MODE=0
SYNTHETIC_SCENARIO=normal

# ---------------------------------------------------------------- chat output
AGENT_VERBOSE=0
CHAT_MAX_SENTENCES=4
