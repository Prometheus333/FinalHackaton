# ---------------------------------------------------------------- credentials
# Never commit real values. Copy this file to .env and fill it in.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
LLM_API_KEY=
# Fallback LLM provider (Groq). Only used when the primary LLM_BASE_URL fails.
GROQ_API_KEY=

# ---------------------------------------------------------------- endpoints
LLM_BASE_URL=https://genailab.tcs.in
LLM_MODEL=azure/genailab-maas-gpt-4.1
ALPACA_TRADING_URL=https://paper-api.alpaca.markets/v2
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# ---------------------------------------------------------------- guardrails
HITL_QTY_THRESHOLD=5
HITL_TURN_QTY_THRESHOLD=5
HITL_NOTIONAL_THRESHOLD=5000

# ---------------------------------------------------------------- demo
# Set to 1 to run against a deterministic synthetic market (no live feed needed).
SYNTHETIC_MODE=0
SYNTHETIC_SCENARIO=normal
