# ---------------------------------------------------------------- demo
# 1 = deterministic synthetic market, no live feed needed.
SYNTHETIC_MODE=0
SYNTHETIC_SCENARIO=normal

# ---------------------------------------------------------------- chat output
# 1 = dump the agent chain-of-thought to the console (debugging only).
AGENT_VERBOSE=0
# Max sentences in a chatbot reply. Asking for "detail" overrides it.
CHAT_MAX_SENTENCES=4
